<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <remove src="Mollie_Payment::css/styles.css"/>
    </head>
    <body>
        <referenceBlock name="product.info.addtocart">
            <block class="Mollie\HyvaCompatibility\Block\Product\View\ApplePay" name="mollie.applepay.button" template="Mollie_Payment::product/view/applepay.phtml">
                <block name="mollie-loader" template="Hyva_Theme::ui/loading.phtml"/>
            </block>

            <block template="Mollie_HyvaCompatibility::product/view/express-components.phtml"
                   name="mollie.express.components.product.hyva"
                   ifconfig="payment/mollie_methods_expresscomponents/active"
            >
                <arguments>
                    <argument name="view_model" xsi:type="object">Mollie\HyvaCompatibility\ViewModel\ExpressComponents</argument>
                </arguments>
            </block>
        </referenceBlock>

        <!-- Added by the mollie_express_components_beta_product handle of Mollie_Payment, they need RequireJS -->
        <referenceBlock name="mollie.express.components.product" remove="true"/>
        <referenceBlock name="mollie.express.components.product.additional" remove="true"/>
    </body>
</page>

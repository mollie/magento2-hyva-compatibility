<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
      xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <head>
        <!-- Luma styling for the wait page; the Hyvä template is styled with Tailwind instead. -->
        <remove src="Mollie_Payment::css/styles.css"/>
    </head>
    <body>
        <!-- Hyvä loads this block on every page. Its CurrentCustomer dependency creates App\View, whose constructor
             creates a second page result while this page builds its layout, which drops the Hyvä head scripts. -->
        <referenceBlock name="category.product.type.details.renderers.configurable" remove="true"/>
    </body>
</page>

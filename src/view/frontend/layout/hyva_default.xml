<page xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance" xsi:noNamespaceSchemaLocation="urn:magento:framework:View/Layout/etc/page_configuration.xsd">
    <body>
        <referenceContainer name="cart-drawer.bottom">
            <block template="Mollie_HyvaCompatibility::applepay/minicart/applepay-button-script.phtml"
                   class="Mollie\Payment\Block\Applepay\Shortcut\Button"
                   name="mollie_cart_script"
                   ifconfig="payment/mollie_methods_applepay/active"
            />
        </referenceContainer>

        <referenceContainer name="extra_actions">
            <block template="Mollie_HyvaCompatibility::checkout/minicart/express-components.phtml"
                   name="mollie.express.components.minicart"
                   ifconfig="payment/mollie_methods_expresscomponents/active"
            />
        </referenceContainer>

        <referenceContainer name="header.container">
            <block template="Mollie_HyvaCompatibility::checkout/minicart/express-components-after.phtml"
                   name="mollie.express.components.minicart.after"
                   ifconfig="payment/mollie_methods_expresscomponents/active"
            >
                <arguments>
                    <argument name="magewire" xsi:type="object">
                        Mollie\HyvaCompatibility\Magewire\Minicart\ExpressComponents
                    </argument>
                </arguments>
            </block>
        </referenceContainer>
    </body>
</page>

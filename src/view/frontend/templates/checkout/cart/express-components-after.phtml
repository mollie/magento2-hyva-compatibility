declare(strict_types=1);

/** @var Escaper $escaper */
/** @var Template $block */

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Mollie\Payment\Controller\Express\CreateSession;

?>

<script>
    function mollieExpressCart() {
        return {
            drawerOpen: false,
            sessionCreated: false,
            createSessionUrl: '<?= $escaper->escapeJs(
                $block->getUrl('mollie/express/createSession', ['type' => CreateSession::TYPE_CART])
            ) ?>',

            init() {
                this.createSession();
            },

            async createSession() {
                if (this.sessionCreated) {
                    return;
                }

                try {
                    const token = await this.fetchClientAccessToken();

                    if (!token) {
                        return;
                    }

                    this.sessionCreated = true;
                    await this.loadMollieJs();
                    this.mountComponent(token);
                } catch (error) {
                    console.error('Mollie Express Components error:', error);
                }
            },

            resetSession() {
                this.sessionCreated = false;
                const mountDiv = document.getElementById('express-component-cart');
                if (mountDiv) {
                    mountDiv.innerHTML = '';
                }
            },

            loadMollieJs() {
                return new Promise((resolve) => {
                    if (typeof Mollie !== 'undefined') {
                        resolve();
                        return;
                    }

                    const script = document.createElement('script');
                    script.src = 'https://js.mollie.com/v2/mollie.js';
                    script.onload = resolve;
                    document.head.appendChild(script);
                });
            },

            mountComponent(token) {
                const checkout = Mollie.Checkout(token);
                const component = checkout.create('express-component', {
                    paymentMethods: {
                        idealcheckout: 'always',
                        applepay: 'never',
                        googlepay: 'never',
                    }
                });
                component.mount(document.getElementById('express-component-cart'));
            },

            async fetchClientAccessToken() {
                const response = await fetch(`${this.createSessionUrl}?form_key=${hyva.getFormKey()}`, {
                    method: 'POST',
                    headers: {'X-Requested-With': 'XMLHttpRequest'},
                });

                if (!response.ok) {
                    throw new Error(`Creating the express session failed with HTTP ${response.status}`);
                }

                return (await response.json()).clientAccessToken;
            },
        }
    }

    window.addEventListener('alpine:init', () => Alpine.data('mollieExpressCart', mollieExpressCart), {once: true});
</script>
<?php isset($hyvaCsp) && $hyvaCsp->registerInlineScript() ?>

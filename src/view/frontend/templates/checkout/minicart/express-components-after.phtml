declare(strict_types=1);

/** @var Escaper $escaper */
/** @var Template $block */
/** @var ExpressComponents $viewModel */

use Magento\Framework\Escaper;
use Magento\Framework\View\Element\Template;
use Mollie\HyvaCompatibility\ViewModel\ExpressComponents;

$viewModel = $block->getData('view_model');

if (!$viewModel->shouldShowInMinicart()) {
    return;
}
?>

<script>
    function mollieExpressMinicart() {
        const STATUS_CUSTOMER_DETAILS_REQUIRED = 422;

        return {
            drawerOpen: false,
            sessionCreated: false,
            isCreatingSession: false,
            isCustomer: false,
            isBetaEnabled: <?= $viewModel->isBetaEnabled() ? 'true' : 'false' ?>,
            createSessionUrl: '<?= $escaper->escapeJs($block->getUrl('mollie/express/createSession')) ?>',

            init() {
                window.addEventListener('toggle-cart', (event) => {
                    this.drawerOpen = event.detail.isOpen;
                    this.createSession();
                });

                window.addEventListener('private-content-loaded', (event) => {
                    this.isCustomer = Boolean(event.detail.data.customer?.firstname);

                    // The drawer can open before the customer data arrived, so retry when no session was created.
                    if (!this.drawerOpen || this.isCreatingSession) {
                        return;
                    }

                    if (this.sessionCreated) {
                        this.resetSession();
                    }

                    this.createSession();
                });
            },

            /*
             * The minicart has no email of a guest. Only Mollie accounts in the beta can collect it, so without the
             * beta the session would always be refused.
             */
            canPayAsCustomer() {
                return this.isBetaEnabled || this.isCustomer;
            },

            async createSession() {
                if (!this.drawerOpen || this.sessionCreated || this.isCreatingSession || !this.canPayAsCustomer()) {
                    return;
                }

                this.isCreatingSession = true;
                try {
                    const token = await this.fetchClientAccessToken();

                    if (!token) {
                        return;
                    }

                    this.sessionCreated = true;
                    await this.loadMollieJs();
                    this.mountComponent(token);
                } catch (error) {
                    console.error('Mollie Express Components error:', error);
                } finally {
                    this.isCreatingSession = false;
                }
            },

            resetSession() {
                this.sessionCreated = false;
                const mountDiv = document.getElementById('express-component-minicart');
                if (mountDiv) {
                    mountDiv.innerHTML = '';
                }
            },

            loadMollieJs() {
                return new Promise((resolve) => {
                    if (typeof Mollie !== 'undefined') {
                        resolve();
                        return;
                    }

                    const script = document.createElement('script');
                    script.src = 'https://js.mollie.com/v2/mollie.js';
                    script.onload = resolve;
                    document.head.appendChild(script);
                });
            },

            mountComponent(token) {
                const checkout = Mollie.Checkout(token);
                const component = checkout.create('express-component', {
                    paymentMethods: {
                        idealcheckout: 'always',
                        applepay: 'never',
                        googlepay: 'never',
                    }
                });
                component.mount(document.getElementById('express-component-minicart'));
            },

            async fetchClientAccessToken() {
                const response = await fetch(`${this.createSessionUrl}?form_key=${hyva.getFormKey()}`, {
                    method: 'POST',
                    headers: {'X-Requested-With': 'XMLHttpRequest'},
                });

                if (response.status === STATUS_CUSTOMER_DETAILS_REQUIRED) {
                    return null;
                }

                if (!response.ok) {
                    throw new Error(`Creating the express session failed with HTTP ${response.status}`);
                }

                return (await response.json()).clientAccessToken;
            },
        }
    }

    window.addEventListener('alpine:init', () => Alpine.data('mollieExpressMinicart', mollieExpressMinicart), {once: true});
</script>
<?php isset($hyvaCsp) && $hyvaCsp->registerInlineScript() ?>
